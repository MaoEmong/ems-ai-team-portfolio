# Examples only. Replace password/secret placeholders locally before starting.
# Keys checked against backend application.yml and docker-compose.yml.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ems
DB_USERNAME=ems_example
DB_PASSWORD=replace-with-local-db-password
DB_ROOT_PASSWORD=replace-with-local-root-password
# Required: random secret, at least 32 UTF-8 bytes (not just 32 characters).
JWT_SECRET=replace-with-local-random-secret-at-least-32-bytes
# Required: max 50 chars; DEMO### pattern is reserved for seed employees.
ADMIN_LOGIN_ID=ADMIN001
# Required: nonblank, at most 72 UTF-8 bytes; existing DB passwords are not reset.
ADMIN_INITIAL_PASSWORD=replace-with-local-admin-password
# Optional: initial password for DEMO001 (synthetic ADMIN), fresh empty DB only.
# Blank means no known demo login password. Existing passwords are never reset.
# To demonstrate a second approver, set a local nonblank value (max 72 UTF-8 bytes).
DEMO_ADMIN_INITIAL_PASSWORD=

# AI provider: mock is a deterministic demo, not real inference.
EMS_AI_PROVIDER=mock
# Optional model override; Ollama requires an already installed model.
EMS_AI_MODEL=
# Provider request timeout in milliseconds, maximum 30000.
EMS_AI_TIMEOUT_MS=30000
# Maximum generated tokens (default 1024).
EMS_AI_MAX_TOKENS=1024
# Host Ollama from Compose; use localhost:11434 for a host backend.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Anthropic endpoint; server configuration only.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional secret: leave blank here; supply locally only for Anthropic.
ANTHROPIC_API_KEY=
# Enable ADMIN-only employee filter suggestions.
EMS_AI_EMPLOYEE_SEARCH_ENABLED=true
# Enable authorized FINALIZED evaluation summaries.
EMS_AI_EVALUATION_SUMMARY_ENABLED=true
# Enable fictional policy Q&A.
EMS_AI_POLICY_QA_ENABLED=true
