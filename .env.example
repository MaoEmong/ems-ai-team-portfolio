# Examples only. Replace password/secret placeholders locally before starting.
# Keys checked against backend application.yml and docker-compose.yml.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ems
DB_USERNAME=ems_example
DB_PASSWORD=replace-with-local-db-password
DB_ROOT_PASSWORD=replace-with-local-root-password
# Required: random secret, at least 32 UTF-8 bytes (not just 32 characters).
JWT_SECRET=replace-with-local-random-secret-at-least-32-bytes
# Required: max 50 chars; DEMO### pattern is reserved for seed employees.
ADMIN_LOGIN_ID=ADMIN001
# Required: nonblank, at most 72 UTF-8 bytes; existing DB passwords are not reset.
ADMIN_INITIAL_PASSWORD=replace-with-local-admin-password
